FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    openmpi-bin \
    libopenmpi-dev \
    openssh-server \
    openssh-client \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY openshmem_sort.c .

# Compile OpenSHMEM code using OpenMPI's oshcc wrapper
RUN oshcc -O3 openshmem_sort.c -o openshmem_sort

# Setup passwordless SSH for mpirun/oshrun execution inside K8s
RUN mkdir /var/run/sshd && \
    ssh-keygen -A && \
    ssh-keygen -t rsa -N "" -f /root/.ssh/id_rsa && \
    cp /root/.ssh/id_rsa.pub /root/.ssh/authorized_keys && \
    echo "StrictHostKeyChecking no" >> /etc/ssh/ssh_config

EXPOSE 22