apiVersion: v1
kind: Service
metadata:
  name: jax-tpu-svc
spec:
  clusterIP: None
  publishNotReadyAddresses: true
  selector:
    job-name: jax-tpu-benchmark
---
apiVersion: batch/v1
kind: Job
metadata:
  name: jax-tpu-benchmark
spec:
  completions: 4
  parallelism: 4
  completionMode: Indexed
  template:
    metadata:
      labels:
        job-name: jax-tpu-benchmark
    spec:
      subdomain: jax-tpu-svc
      restartPolicy: Never
      nodeSelector:
        cloud.google.com/gke-tpu-accelerator: tpu-v6e-slice
        cloud.google.com/gke-tpu-topology: 4x4
        cloud.google.com/gke-nodepool: mb-tpu-v6e-multi-16
      containers:
        - name: jax-tpu-container
          image: europe-west4-docker.pkg.dev/mb-development-447000/openshmem-benchmarks/tpu-jax-sort:v1
          command: ["/bin/bash", "-c"]
          args:
            - |
              cat << 'EOF' > /app/tpu_jax_sort.py
              import jax
              jax.config.update("jax_enable_x64", True)
              
              import jax.numpy as jnp
              from jax.sharding import Mesh, PartitionSpec as P
              from jax.experimental import shard_map
              import time
              import os
              import json

              # 50,000,000 elements * 8 bytes = 0.4 GB per chip
              # 0.4 GB * 16 Chips = 6.4 GB Total Dataset
              ELEMENTS_PER_CHIP = 50_000_000

              def main():
                  coordinator = "jax-tpu-benchmark-0.jax-tpu-svc.default.svc.cluster.local:1234"
                  process_id = int(os.environ.get("JOB_COMPLETION_INDEX", 0))
                  
                  print(f"[POD {process_id}] Initializing JAX distributed cluster...", flush=True)
                  jax.distributed.initialize(
                      coordinator_address=coordinator,
                      num_processes=4,
                      process_id=process_id,
                      initialization_timeout=1800
                  )
                  
                  devices = jax.devices()
                  num_devices = len(devices)
                  mesh = Mesh(devices, ('x',))
                  print(f"[POD {process_id}] Connected. Total TPU chips across cluster: {num_devices}.", flush=True)

                  # -------------------------------------------------------------
                  # KERNEL DEFINITIONS
                  # -------------------------------------------------------------
                  def _gen_kernel():
                      dev_idx = jax.lax.axis_index('x')
                      key = jax.random.fold_in(jax.random.PRNGKey(42), dev_idx)
                      keys_per_bucket = ELEMENTS_PER_CHIP // num_devices
                      k = jax.random.bits(key, (num_devices, keys_per_bucket), dtype=jnp.uint64)
                      mask = jnp.array(0x0FFFFFFFFFFFFFFF, dtype=jnp.uint64)
                      k = jnp.bitwise_and(k, mask)
                      bucket_ids = jnp.arange(num_devices, dtype=jnp.uint64)[:, None]
                      prefixes = jnp.left_shift(bucket_ids, 60)
                      return jnp.bitwise_or(k, prefixes)

                  @jax.jit
                  def step1_generate_keys():
                      return shard_map.shard_map(
                          _gen_kernel, mesh=mesh, in_specs=(), out_specs=P('x'), check_rep=False
                      )()

                  def _exchange_and_sort_kernel(keys):
                      keys = jnp.sort(keys, axis=-1)
                      keys = jax.lax.all_to_all(keys, 'x', 0, 0)
                      flat_keys = keys.flatten()
                      return jnp.sort(flat_keys)

                  @jax.jit
                  def step2_sort_phase(keys):
                      return shard_map.shard_map(
                          _exchange_and_sort_kernel, mesh=mesh, in_specs=P('x'), out_specs=P('x'), check_rep=False
                      )(keys)

                  def _verify_kernel(keys):
                      local_ok = jnp.all(keys[:-1] <= keys[1:])
                      l_min = keys[0:1]
                      l_max = keys[-1:]
                      
                      all_mins = jax.lax.all_gather(l_min, 'x', tiled=True)
                      all_maxes = jax.lax.all_gather(l_max, 'x', tiled=True)
                      all_flags = jax.lax.all_gather(jnp.array([local_ok], dtype=jnp.int32), 'x', tiled=True)
                      
                      boundaries_ok = jnp.all(all_maxes[:-1] <= all_mins[1:])
                      global_ok = jnp.logical_and(jnp.all(all_flags == 1), boundaries_ok)
                      return jnp.where(global_ok, 1, 0)

                  @jax.jit
                  def verify_sorted(keys):
                      return shard_map.shard_map(
                          _verify_kernel, mesh=mesh, in_specs=P('x'), out_specs=P(), check_rep=False
                      )(keys)

                  # -------------------------------------------------------------
                  # PHASE 1: GENERATION EXECUTION & TIMING
                  # -------------------------------------------------------------
                  print(f"[POD {process_id}] [PHASE 1] Generating 64-bit integers in TPU HBM...", flush=True)
                  gen_start = time.time()
                  raw_keys = step1_generate_keys()
                  jax.block_until_ready(raw_keys)
                  gen_end = time.time()
                  t_gen = gen_end - gen_start

                  # -------------------------------------------------------------
                  # PHASE 2: ICI EXCHANGE & SORTING EXECUTION & TIMING
                  # -------------------------------------------------------------
                  print(f"[POD {process_id}] [PHASE 2] Exchanging buckets via ICI and sorting...", flush=True)
                  sort_start = time.time()
                  sorted_keys = step2_sort_phase(raw_keys)
                  jax.block_until_ready(sorted_keys)
                  sort_end = time.time()
                  t_sort = sort_end - sort_start

                  # -------------------------------------------------------------
                  # VERIFICATION PASS
                  # -------------------------------------------------------------
                  valid_scalar = verify_sorted(sorted_keys)
                  jax.block_until_ready(valid_scalar)
                  is_passed_int = int(valid_scalar)

                  # -------------------------------------------------------------
                  # METRICS CALCULATION & REPORTING
                  # -------------------------------------------------------------
                  if process_id == 0:
                      total_data_gb = (ELEMENTS_PER_CHIP * 8 * num_devices) / 1e9
                      validation_passed = (is_passed_int == 1)
                      
                      network_fraction = (num_devices - 1) / num_devices
                      network_traffic_gb = total_data_gb * network_fraction
                      memory_traffic_gb = total_data_gb * 6  

                      # Phase 1 Metrics
                      gen_throughput_gbps = total_data_gb / t_gen

                      # Phase 2 Metrics
                      effective_network_gbps = network_traffic_gb / t_sort
                      effective_memory_bandwidth_gbps = memory_traffic_gb / t_sort

                      metrics = {
                          "benchmark": "JAX Phase-Separated Distributed Bucket Sort",
                          "total_chips": num_devices,
                          "total_data_gb": total_data_gb,
                          "phase1_generation": {
                              "execution_seconds": t_gen,
                              "hbm_write_throughput_gbps": gen_throughput_gbps,
                              "ici_network_traffic_gb": 0.0,
                              "effective_network_gbps": 0.0
                          },
                          "phase2_sorting_and_exchange": {
                              "execution_seconds": t_sort,
                              "ici_network_traffic_gb": network_traffic_gb,
                              "effective_network_gbps": effective_network_gbps,
                              "effective_memory_bandwidth_gbps": effective_memory_bandwidth_gbps
                          },
                          "global_validation_passed": validation_passed
                      }
                      
                      with open("/tmp/jax_metrics.json", "w") as f:
                          json.dump(metrics, f, indent=2)
                      
                      print("\n=======================================================", flush=True)
                      print("PHASE-BY-PHASE BENCHMARK METRICS", flush=True)
                      print("=======================================================", flush=True)
                      print(f"Total Dataset Size             : {total_data_gb:.2f} GB", flush=True)
                      print(f"Global Validation Status       : {'[PASSED]' if validation_passed else '[FAILED]'}", flush=True)
                      print("-------------------------------------------------------", flush=True)
                      print("PHASE 1: 64-Bit Integer Generation (In-HBM)", flush=True)
                      print(f"  Execution Time               : {t_gen:.4f} seconds", flush=True)
                      print(f"  HBM Generation Throughput    : {gen_throughput_gbps:.2f} GB/s", flush=True)
                      print(f"  ICI Network Traffic          : 0.00 GB", flush=True)
                      print("-------------------------------------------------------", flush=True)
                      print("PHASE 2: ICI Exchange & Bucket Sorting", flush=True)
                      print(f"  Execution Time               : {t_sort:.4f} seconds", flush=True)
                      print(f"  ICI Network Traffic Routed   : {network_traffic_gb:.2f} GB", flush=True)
                      print(f"  Effective ICI Network Speed  : {effective_network_gbps:.2f} GB/s", flush=True)
                      print(f"  Effective Memory Bandwidth   : {effective_memory_bandwidth_gbps:.2f} GB/s", flush=True)
                      print("=======================================================\n", flush=True)

                  time.sleep(2)
                  jax.distributed.shutdown()

              if __name__ == "__main__":
                  main()
              EOF
              
              sleep 5
              python3 -u /app/tpu_jax_sort.py
          env:
            - name: JOB_COMPLETION_INDEX
              valueFrom:
                fieldRef:
                  fieldPath: metadata.annotations['batch.kubernetes.io/job-completion-index']
            - name: PYTHONUNBUFFERED
              value: "1"
            - name: JAX_COORDINATION_SERVICE_TIMEOUT_S
              value: "1800"
          resources:
            limits:
              google.com/tpu: "4"
              memory: "150Gi"
            requests:
              google.com/tpu: "4"
              cpu: "8"
              memory: "150Gi"
