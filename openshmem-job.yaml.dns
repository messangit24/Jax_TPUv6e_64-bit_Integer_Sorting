apiVersion: v1
kind: Service
metadata:
  name: openshmem-svc
spec:
  clusterIP: None
  selector:
    job-name: openshmem-benchmark
  ports:
    - name: ssh
      port: 22
---
apiVersion: batch/v1
kind: Job
metadata:
  name: openshmem-benchmark
spec:
  completions: 4
  parallelism: 4
  completionMode: Indexed
  template:
    metadata:
      labels:
        job-name: openshmem-benchmark
    spec:
      subdomain: openshmem-svc
      restartPolicy: Never
      nodeSelector:
        cloud.google.com/gke-tpu-accelerator: tpu-v6e-slice
        cloud.google.com/gke-tpu-topology: 4x4
        cloud.google.com/gke-nodepool: mb-tpu-v6e-multi-16
      containers:
        - name: openshmem-container
          image: europe-west4-docker.pkg.dev/mb-development-447000/openshmem-benchmarks/openshmem-sort:v1
          command: ["/bin/bash", "-c"]
          args:
            - |
              /usr/sbin/sshd
              if [ $JOB_COMPLETION_INDEX -eq 0 ]; then
                echo "Waiting for SSH to become ready on all 4 pods..."
                for i in 0 1 2 3; do
                  until host openshmem-benchmark-${i}.openshmem-svc > /dev/null 2>&1; do
                    echo "Waiting for DNS resolution of openshmem-benchmark-${i}.openshmem-svc..."
                    sleep 2
                  done
                done
                sleep 5

                HOSTS="openshmem-benchmark-0.openshmem-svc,openshmem-benchmark-1.openshmem-svc,openshmem-benchmark-2.openshmem-svc,openshmem-benchmark-3.openshmem-svc"

                oshrun --allow-run-as-root \
                  -mca orte_keep_fqdn_hostnames 1 \
                  -mca plm_rsh_args "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null" \
                  -H "${HOSTS}" \
                  -np 16 /app/openshmem_sort
              else
                sleep 3600
              fi
          resources:
            limits:
              google.com/tpu: "4"
            requests:
              google.com/tpu: "4"
              cpu: "8"
              memory: "140Gi"
